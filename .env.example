# --- Vercel Postgres (auto-filled by `vercel env pull .env.local`) ---
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # generate: openssl rand -base64 32

# --- GitHub OAuth app ---
GITHUB_ID=
GITHUB_SECRET=

# --- The ONLY account allowed to log in (your GitHub primary email) ---
OWNER_EMAIL=you@example.com
